<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Telegram Bot Token"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <EditText
        android:id="@+id/etBotToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="123456:ABC-..."/>

    <TextView
        android:text="Telegram Chat ID"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <EditText
        android:id="@+id/etChatId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="-123456789 or 12345678"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_marginTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"/>

    <Button
        android:id="@+id/btnTest"
        android:layout_marginTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Test Send"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnRequestPermission"
        android:layout_marginTop="18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable RECEIVE_SMS Permission"/>

</LinearLayout>